# Copy to .env and replace every change-me. Never commit .env.
DB_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me
FLUXIE_MIGRATOR_PASSWORD=change-me
FLUXIE_APP_PASSWORD=change-me

# Runtime (app role: DML only) and migrations (schema owner).
DATABASE_URL=postgres://fluxie_app:change-me@127.0.0.1:5432/fluxie_brain
MIGRATOR_DATABASE_URL=postgres://fluxie_migrator:change-me@127.0.0.1:5432/fluxie_brain

# Test database (recreated by tests).
TEST_DATABASE_URL=postgres://fluxie_app:change-me@127.0.0.1:5432/fluxie_brain_test
TEST_MIGRATOR_DATABASE_URL=postgres://fluxie_migrator:change-me@127.0.0.1:5432/fluxie_brain_test

# Embeddings provider (OpenAI-compatible /v1/embeddings). Defaults point at the local Ollama service.
# Default confirmed by the benchmark (SPEC-embeddings.md): EmbeddingGemma 2 270M.
EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDINGS_MODEL=embeddinggemma-2:270m
# What the local Ollama service pulls on start (docker compose). Unset, it follows EMBEDDINGS_MODEL.
# OLLAMA_MODEL=embeddinggemma-2:270m
# Optional, for an OpenAI-compatible provider that needs a key (sent as Bearer). Refused over plain http unless the
# host is loopback. Leave empty for the local Ollama. Fill it yourself; never commit it.
EMBEDDINGS_API_KEY=
OLLAMA_PORT=11434

# pnpm dogfood:prepare: the project whose docs/ feed the dogfooding (required; there is no default path).
# DOGFOOD_SOURCE=
